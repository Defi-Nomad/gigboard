# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of this deployment (used for the OAuth redirect).
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: any Google account signing in with this email is treated as an
# admin automatically, in addition to whatever is listed in the admin_emails
# table in the database. Leave blank to rely on the table only.
ADMIN_EMAIL=you@example.com

# Optional. Only needed if you use ADMIN_EMAIL above and want it to also
# unlock admin actions in the database (approve/reject jobs), not just the
# admin screens in the UI. Find it in Supabase: Project Settings -> API ->
# "service_role" key (NOT the anon key). Never expose this to the browser -
# it is only read in server code. If you skip this, use the admin_emails
# SQL table method instead (see README "Admin setup") - it works either way.
SUPABASE_SERVICE_ROLE_KEY=
